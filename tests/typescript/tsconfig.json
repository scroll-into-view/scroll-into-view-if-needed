{
  "compilerOptions": {
    "target": "es2015",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "lib": ["es2015", "dom"]
  },
  // The compute-scroll-into-view 4.0.0 types. Remove it once that version is installed
  "include": ["*.ts", "../../src/compute-scroll-into-view.d.ts"]
}
