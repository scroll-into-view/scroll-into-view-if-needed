{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Type tests, only type-checked by `vp check` (see tests/typescript/tsconfig.json)
  "entry": ["tests/typescript/*.ts"],
  // Legacy Cypress/Next.js and web-platform-tests projects that are not run
  // (also ignored by `lint.ignorePatterns` in vite.config.ts)
  "ignore": ["tests/integration/**", "tests/web-platform/**"],
}
